; Godot 项目配置 —— 由 DSH 自动维护
;
; 本项目是「AI 生成模型 → 导入 Godot」的落地宿主工程。
; 约定：所有由生成管线产出的资产都放在 res://assets/ 下，
; 脚本/场景由 DSH 直接读写，禁止依赖编辑器手工操作。

config_version=5

[application]

config/name="GodotModelForge"
config/description="AI 生成 3D 角色资产 → 自动导入 Godot 的验证与集成工程"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray()

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=2
